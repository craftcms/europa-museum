CRAFT_APP_ID=CraftCMS-EuropaMuseum
CRAFT_ENVIRONMENT=dev
CRAFT_SECURITY_KEY="replace-me"
CRAFT_STREAM_LOG=1
CRAFT_BASE_CP_URL=https://cp.europa-museum.ddev.site/
CRAFT_CP_TRIGGER=""

GLOBAL_SITE_URL=https://europa-museum.ddev.site/
