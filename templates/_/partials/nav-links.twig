{# @var craft \craft\web\twig\variables\CraftVariable #}

<nav class="core-nav-links">

    {% if currentSite.handle == 'global' %}

        <a href="#locations" data-router-disabled>{{ 'Locations'|t }}</a>

    {% else %}

        {% for link in navigation.linksRight.all() %}

            <a href="{{ link.url }}" {% if link.url == url('contact') %}data-router-disabled{% endif %}>{{ link.title }}</a>

        {% endfor %}

    {% endif %}

</nav>
