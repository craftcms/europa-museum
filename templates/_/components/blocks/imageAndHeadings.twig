{# @var craft \craft\web\twig\variables\CraftVariable #}

{% set isFirst = isFirst ? 'isFirst' : '' %}

{% set image = theBlock.image.eagerly().one() %}
{% set highlightText = theBlock.highlightText ? 'is-highlighted' : '' %}

{% set hasHeroImage = entry.heroImage is not empty %}

<div class="content-block image-and-headings-block {{ isFirst }} {{ highlightText }} text-color-scheme-{{ theBlock.textColor }}" data-scroll-section>

    <div class="image-and-headings-container">

        <div class="title-container" data-scroll data-scroll-z="8">
            <h3 class="title">
                <span class="pre-heading">
                    {{ theBlock.headingPre }}
                </span>
                <span class="main-heading">
                    {{ theBlock.heading }}
                </span>
            </h3>
        </div>

        {% if theBlock.headingSub %}
            <div class="sub-heading">
                {{ theBlock.headingSub }}
            </div>
        {% endif %}

        {% if image %}
            <div class="image" data-scroll data-scroll-z="-10">
                {# with, classes: 'example' #}
                {% include "_/components/picture" with {
                    asset: image,
                    lazytransition: 'lazyfadeDelay'
                } %}
            </div>
        {% endif %}

    </div>

</div>
