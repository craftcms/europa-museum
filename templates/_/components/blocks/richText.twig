{# @var craft \craft\web\twig\variables\CraftVariable #}

{% set topBorder = theBlock.topBorder ? "topBorder" : "" %}

{% if theBlock.richText %}

    <div class="content-block rich-text-block {{ isFirst }} {{ topBorder }} layout-{{ theBlock.imageHandling }} width-{{ theBlock.layoutWidth }}" data-scroll-section>
        <div class="rich-text">
            {{ theBlock.richText }}
        </div>
    </div>

{% endif %}
