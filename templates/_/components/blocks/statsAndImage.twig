{# @var craft \craft\web\twig\variables\CraftVariable #}

{% set image = theBlock.image.eagerly().one() %}

{% set hasLeftStat = theBlock.statValueLeft is not empty %}
{% set hasRightStat = theBlock.statValueRight is not empty %}

<div class="content-block stats-and-image-block {{ isFirst }}" data-scroll-section>

    <div class="relative">

        <div class="text-container">

            <div class="stat-left {% if hasRightStat %}hide-on-mobile{% endif %}">
                <div class="stat-value">
                    {{ theBlock.statValueLeft }}
                </div>
                <div class="stat-label">
                    {{ theBlock.statLabelLeft }}
                </div>
            </div>

            <div class="info">
                <h4 class="heading">
                    {{ theBlock.heading }}
                </h4>
                <div class="description">
                    {{ theBlock.description }}
                </div>
                <div class="link">
                    {% if theBlock.linkDestination %}
                        {{ theBlock.linkDestination.getLink() }}
                    {% endif %}
                </div>
            </div>

            <div class="stat-right {% if hasRightStat %}hide-on-mobile{% endif %}">
                <div class="stat-value">
                    {{ theBlock.statValueRight }}
                </div>
                <div class="stat-label">
                    {{ theBlock.statLabelRight }}
                </div>
            </div>

        </div>

        {% if image %}
            <div class="image-container w-full">
                {% include "_/components/picture" with {
                    asset: image,
                    transform: 'base',
                    lazytransition: 'lazyfade'
                } %}
            </div>
        {% endif %}

    </div>

</div>
