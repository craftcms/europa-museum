{# @var craft \craft\web\twig\variables\CraftVariable #}

{% set usesAssets = theBlock.slideType == 'assets' %}
{% set slideImages = theBlock.slideImages.eagerly().all() %}
{% set slideEntries = theBlock.slideEntries.eagerly().all() %}

<div class="content-block slider-block {{ isFirst }} {{ usesAssets ? 'is-image' : 'is-entry' }} {{ theBlock.colorTheme }}-ui" data-scroll-section>

    <div class="slider-info">

        <div class="slider-link-container hide-on-tablet">
            {% if theBlock.linkDestination %}
                <a class="slider-link active" href="{{ theBlock.linkDestination.value }}">{{ theBlock.linkDestination.label }}</a>
            {% endif %}
        </div>

        <h4 class="slider-heading {% if not theBlock.heading %}hide-on-tablet{% endif %}">
            {{ theBlock.heading }}
        </h4>

        <div class="slider-arrows hide-on-tablet">

            <button class="btn-slider-prev" aria-label="Previous">
                {% include "_/svg/arrowLeft" %}
            </button>

            <span class="divider">|</span>

            <button class="btn-slider-next" aria-label="Next">
                {% include "_/svg/arrowRight" %}
            </button>

        </div>

    </div>

    <div class="slider-container">

        <div class="slider slide-{{ theBlock.sliderMode }}">

            {% if usesAssets %}

                {% for slideImage in slideImages %}

                    {% set image = slideImage %}
                    {% do image.setTransform({
                        width: 500,
                        height: 500,
                        quality: 80,
                        format: 'jpg',
                        mode: 'crop',
                    }) %}

                    <div class="slide no-underline">

                        <div class="slide-image-container">
                            <img class="slide-image" src="{{ image.url }}" alt="{{ image.title }}">
                        </div>

                        <div class="slide-info">

                            <div class="slide-caption">
                                {{ image.imageCaption }}
                            </div>

                        </div>

                    </div>

                {% endfor %}

            {% else %}

                {% for slideEntry in slideEntries | filter(e => e.heroImage is not empty) %}

                    {% set heroImage = slideEntry.heroImage.one() %}
                    {% do heroImage.setTransform({
                        width: 500,
                        height: 500,
                        quality: 80,
                        format: 'jpg',
                        mode: 'crop',
                    }) %}

                    <a class="slide no-underline" href="{{ slideEntry.url }}">

                        <div class="slide-image-container">
                            <img class="slide-image" src="{{ heroImage.url }}" alt="{{ heroImage.alt ?: heroImage.title }}">
                        </div>

                        <div class="slide-info">

                            <div class="slide-title">
                                {{ slideEntry.title }}
                            </div>

                            {# Add a pip for the category to news articles: #}

                            {% if slideEntry.type.handle == 'newsArticle' %}

                                {% set slideNewsCategory = slideEntry.newsCategory.one() %}

                                {% if slideNewsCategory %}
                                    <div class="slide-news-category">
                                        {{ slideNewsCategory }}
                                    </div>
                                {% endif %}

                            {% endif %}

                            <div class="slide-date">
                                {% switch slideEntry.type.handle %}
                                    {% case 'exhibit' %}
                                        {% if slideEntry.dateExpression is not empty %}
                                            {# Custom expression: #}
                                            {{ slideEntry.dateExpression }}
                                        {% elseif slideEntry.dateStart and slideEntry.dateStart > now %}
                                            {# Future: #}
                                            Opens {{ slideEntry.dateStart | date('j F Y') }}
                                        {% elseif slideEntry.dateStart < now and slideEntry.dateEnd > now %}
                                            {# Current: #}
                                            Open though {{ slideEntry.dateEnd | date('j F Y') }}
                                        {% elseif slideEntry.dateEnd and slideEntry.dateEnd < now %}
                                            {# Ended already: #}
                                            Ended {{ slideEntry.dateEnd | date('j F Y') }}
                                        {% elseif slideEntry.dateStart and slideEntry.dateEnd %}
                                            {# Show the range, when available: #}
                                            {{ slideEntry.dateStart | date('j F Y') }}–{{ slideEntry.dateEnd | date('j F Y') }}
                                        {% else %}
                                            {{ slideEntry.postDate | date('j F Y') }}
                                        {% endif %}
                                    {% default %}
                                        {{ slideEntry.postDate | date('m.y') }}
                                {% endswitch %}
                            </div>

                        </div>

                    </a>

                {% endfor %}

            {% endif %}

        </div>

    </div>

</div>
